# Root-level gitignore for the aptrive monorepo
# The aptrive/ subfolder has its own .gitignore for Next.js specifics.

# dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/
*.swp
*.swo

# env files
.env*
!.env.local.example
!.env.example

# debug logs
npm-debug.log*
yarn-debug.log*
